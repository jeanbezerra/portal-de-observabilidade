<?xml version="1.0" encoding="UTF-8"?>
<!-- Fluxo didatico de liberacao em duas alcadas. -->
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="workflow-service-approval-requests"
                   exporter="jBPM Process Modeler"
                   exporterVersion="2.0"
                   targetNamespace="http://www.omg.org/bpmn20">

    <bpmn2:itemDefinition id="requestIdItem" structureRef="String"/>
    <bpmn2:itemDefinition id="titleItem" structureRef="String"/>
    <bpmn2:itemDefinition id="requesterItem" structureRef="String"/>
    <bpmn2:itemDefinition id="approverItem" structureRef="String"/>
    <bpmn2:itemDefinition id="approvalItem" structureRef="Boolean"/>
    <bpmn2:itemDefinition id="commentItem" structureRef="String"/>
    <bpmn2:itemDefinition id="objectItem" structureRef="Object"/>

    <bpmn2:process id="approvalRequests"
                   drools:packageName="com.porto.ciops.coa.obs.workflow.process"
                   drools:version="1.0"
                   name="Solicitacao de liberacao em duas alcadas"
                   isExecutable="true"
                   processType="Public">

        <bpmn2:property id="requestId" itemSubjectRef="requestIdItem" name="requestId"/>
        <bpmn2:property id="title" itemSubjectRef="titleItem" name="title"/>
        <bpmn2:property id="requester" itemSubjectRef="requesterItem" name="requester"/>
        <bpmn2:property id="firstApprover" itemSubjectRef="approverItem" name="firstApprover"/>
        <bpmn2:property id="firstLineApproval" itemSubjectRef="approvalItem" name="firstLineApproval"/>
        <bpmn2:property id="firstLineComment" itemSubjectRef="commentItem" name="firstLineComment"/>
        <bpmn2:property id="secondLineApproval" itemSubjectRef="approvalItem" name="secondLineApproval"/>
        <bpmn2:property id="secondLineComment" itemSubjectRef="commentItem" name="secondLineComment"/>

        <bpmn2:startEvent id="start" name="Solicitacao recebida">
            <bpmn2:outgoing>startToFirstApproval</bpmn2:outgoing>
        </bpmn2:startEvent>

        <bpmn2:userTask id="firstApproval" name="Primeira alcada">
            <bpmn2:extensionElements>
                <drools:metaData name="elementname">
                    <drools:metaValue><![CDATA[Primeira alcada]]></drools:metaValue>
                </drools:metaData>
            </bpmn2:extensionElements>
            <bpmn2:incoming>startToFirstApproval</bpmn2:incoming>
            <bpmn2:outgoing>firstToDecision</bpmn2:outgoing>
            <bpmn2:ioSpecification id="firstApprovalIo">
                <bpmn2:dataInput id="firstTaskName" drools:dtype="Object" itemSubjectRef="objectItem" name="TaskName"/>
                <bpmn2:dataInput id="firstGroupId" drools:dtype="Object" itemSubjectRef="objectItem" name="GroupId"/>
                <bpmn2:dataInput id="firstSkippable" drools:dtype="Object" itemSubjectRef="objectItem" name="Skippable"/>
                <bpmn2:dataInput id="firstRequestId" drools:dtype="String" itemSubjectRef="requestIdItem" name="requestId"/>
                <bpmn2:dataInput id="firstTitle" drools:dtype="String" itemSubjectRef="titleItem" name="title"/>
                <bpmn2:dataInput id="firstRequester" drools:dtype="String" itemSubjectRef="requesterItem" name="requester"/>
                <bpmn2:dataOutput id="firstActorId" drools:dtype="String" itemSubjectRef="approverItem" name="ActorId"/>
                <bpmn2:dataOutput id="firstApproved" drools:dtype="Boolean" itemSubjectRef="approvalItem" name="approved"/>
                <bpmn2:dataOutput id="firstComment" drools:dtype="String" itemSubjectRef="commentItem" name="comment"/>
                <bpmn2:inputSet id="firstInputSet">
                    <bpmn2:dataInputRefs>firstTaskName</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>firstGroupId</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>firstSkippable</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>firstRequestId</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>firstTitle</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>firstRequester</bpmn2:dataInputRefs>
                </bpmn2:inputSet>
                <bpmn2:outputSet id="firstOutputSet">
                    <bpmn2:dataOutputRefs>firstActorId</bpmn2:dataOutputRefs>
                    <bpmn2:dataOutputRefs>firstApproved</bpmn2:dataOutputRefs>
                    <bpmn2:dataOutputRefs>firstComment</bpmn2:dataOutputRefs>
                </bpmn2:outputSet>
            </bpmn2:ioSpecification>
            <bpmn2:dataInputAssociation id="firstTaskNameAssociation">
                <bpmn2:targetRef>firstTaskName</bpmn2:targetRef>
                <bpmn2:assignment id="firstTaskNameAssignment">
                    <bpmn2:from xsi:type="bpmn2:tFormalExpression">firstLineApproval</bpmn2:from>
                    <bpmn2:to xsi:type="bpmn2:tFormalExpression">firstTaskName</bpmn2:to>
                </bpmn2:assignment>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="firstGroupAssociation">
                <bpmn2:targetRef>firstGroupId</bpmn2:targetRef>
                <bpmn2:assignment id="firstGroupAssignment">
                    <bpmn2:from xsi:type="bpmn2:tFormalExpression">approvers</bpmn2:from>
                    <bpmn2:to xsi:type="bpmn2:tFormalExpression">firstGroupId</bpmn2:to>
                </bpmn2:assignment>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="firstSkippableAssociation">
                <bpmn2:targetRef>firstSkippable</bpmn2:targetRef>
                <bpmn2:assignment id="firstSkippableAssignment">
                    <bpmn2:from xsi:type="bpmn2:tFormalExpression">false</bpmn2:from>
                    <bpmn2:to xsi:type="bpmn2:tFormalExpression">firstSkippable</bpmn2:to>
                </bpmn2:assignment>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="firstRequestIdAssociation">
                <bpmn2:sourceRef>requestId</bpmn2:sourceRef>
                <bpmn2:targetRef>firstRequestId</bpmn2:targetRef>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="firstTitleAssociation">
                <bpmn2:sourceRef>title</bpmn2:sourceRef>
                <bpmn2:targetRef>firstTitle</bpmn2:targetRef>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="firstRequesterAssociation">
                <bpmn2:sourceRef>requester</bpmn2:sourceRef>
                <bpmn2:targetRef>firstRequester</bpmn2:targetRef>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataOutputAssociation id="firstActorAssociation">
                <bpmn2:sourceRef>firstActorId</bpmn2:sourceRef>
                <bpmn2:targetRef>firstApprover</bpmn2:targetRef>
            </bpmn2:dataOutputAssociation>
            <bpmn2:dataOutputAssociation id="firstApprovedAssociation">
                <bpmn2:sourceRef>firstApproved</bpmn2:sourceRef>
                <bpmn2:targetRef>firstLineApproval</bpmn2:targetRef>
            </bpmn2:dataOutputAssociation>
            <bpmn2:dataOutputAssociation id="firstCommentAssociation">
                <bpmn2:sourceRef>firstComment</bpmn2:sourceRef>
                <bpmn2:targetRef>firstLineComment</bpmn2:targetRef>
            </bpmn2:dataOutputAssociation>
        </bpmn2:userTask>

        <bpmn2:exclusiveGateway id="firstDecision"
                                name="Primeira alcada aprovou?"
                                default="decisionToRejected"
                                gatewayDirection="Diverging">
            <bpmn2:incoming>firstToDecision</bpmn2:incoming>
            <bpmn2:outgoing>decisionToSecondApproval</bpmn2:outgoing>
            <bpmn2:outgoing>decisionToRejected</bpmn2:outgoing>
        </bpmn2:exclusiveGateway>

        <bpmn2:userTask id="secondApproval" name="Segunda alcada">
            <bpmn2:extensionElements>
                <drools:metaData name="elementname">
                    <drools:metaValue><![CDATA[Segunda alcada]]></drools:metaValue>
                </drools:metaData>
            </bpmn2:extensionElements>
            <bpmn2:incoming>decisionToSecondApproval</bpmn2:incoming>
            <bpmn2:outgoing>secondApprovalToEnd</bpmn2:outgoing>
            <bpmn2:ioSpecification id="secondApprovalIo">
                <bpmn2:dataInput id="secondTaskName" drools:dtype="Object" itemSubjectRef="objectItem" name="TaskName"/>
                <bpmn2:dataInput id="secondGroupId" drools:dtype="Object" itemSubjectRef="objectItem" name="GroupId"/>
                <bpmn2:dataInput id="secondSkippable" drools:dtype="Object" itemSubjectRef="objectItem" name="Skippable"/>
                <bpmn2:dataInput id="excludedFirstApprover" drools:dtype="String" itemSubjectRef="approverItem" name="ExcludedOwnerId"/>
                <bpmn2:dataInput id="secondRequestId" drools:dtype="String" itemSubjectRef="requestIdItem" name="requestId"/>
                <bpmn2:dataInput id="secondTitle" drools:dtype="String" itemSubjectRef="titleItem" name="title"/>
                <bpmn2:dataInput id="secondRequester" drools:dtype="String" itemSubjectRef="requesterItem" name="requester"/>
                <bpmn2:dataOutput id="secondApproved" drools:dtype="Boolean" itemSubjectRef="approvalItem" name="approved"/>
                <bpmn2:dataOutput id="secondComment" drools:dtype="String" itemSubjectRef="commentItem" name="comment"/>
                <bpmn2:inputSet id="secondInputSet">
                    <bpmn2:dataInputRefs>secondTaskName</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>secondGroupId</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>secondSkippable</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>excludedFirstApprover</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>secondRequestId</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>secondTitle</bpmn2:dataInputRefs>
                    <bpmn2:dataInputRefs>secondRequester</bpmn2:dataInputRefs>
                </bpmn2:inputSet>
                <bpmn2:outputSet id="secondOutputSet">
                    <bpmn2:dataOutputRefs>secondApproved</bpmn2:dataOutputRefs>
                    <bpmn2:dataOutputRefs>secondComment</bpmn2:dataOutputRefs>
                </bpmn2:outputSet>
            </bpmn2:ioSpecification>
            <bpmn2:dataInputAssociation id="secondTaskNameAssociation">
                <bpmn2:targetRef>secondTaskName</bpmn2:targetRef>
                <bpmn2:assignment id="secondTaskNameAssignment">
                    <bpmn2:from xsi:type="bpmn2:tFormalExpression">secondLineApproval</bpmn2:from>
                    <bpmn2:to xsi:type="bpmn2:tFormalExpression">secondTaskName</bpmn2:to>
                </bpmn2:assignment>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="secondGroupAssociation">
                <bpmn2:targetRef>secondGroupId</bpmn2:targetRef>
                <bpmn2:assignment id="secondGroupAssignment">
                    <bpmn2:from xsi:type="bpmn2:tFormalExpression">approvers</bpmn2:from>
                    <bpmn2:to xsi:type="bpmn2:tFormalExpression">secondGroupId</bpmn2:to>
                </bpmn2:assignment>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="secondSkippableAssociation">
                <bpmn2:targetRef>secondSkippable</bpmn2:targetRef>
                <bpmn2:assignment id="secondSkippableAssignment">
                    <bpmn2:from xsi:type="bpmn2:tFormalExpression">false</bpmn2:from>
                    <bpmn2:to xsi:type="bpmn2:tFormalExpression">secondSkippable</bpmn2:to>
                </bpmn2:assignment>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="excludedApproverAssociation">
                <bpmn2:sourceRef>firstApprover</bpmn2:sourceRef>
                <bpmn2:targetRef>excludedFirstApprover</bpmn2:targetRef>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="secondRequestIdAssociation">
                <bpmn2:sourceRef>requestId</bpmn2:sourceRef>
                <bpmn2:targetRef>secondRequestId</bpmn2:targetRef>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="secondTitleAssociation">
                <bpmn2:sourceRef>title</bpmn2:sourceRef>
                <bpmn2:targetRef>secondTitle</bpmn2:targetRef>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataInputAssociation id="secondRequesterAssociation">
                <bpmn2:sourceRef>requester</bpmn2:sourceRef>
                <bpmn2:targetRef>secondRequester</bpmn2:targetRef>
            </bpmn2:dataInputAssociation>
            <bpmn2:dataOutputAssociation id="secondApprovedAssociation">
                <bpmn2:sourceRef>secondApproved</bpmn2:sourceRef>
                <bpmn2:targetRef>secondLineApproval</bpmn2:targetRef>
            </bpmn2:dataOutputAssociation>
            <bpmn2:dataOutputAssociation id="secondCommentAssociation">
                <bpmn2:sourceRef>secondComment</bpmn2:sourceRef>
                <bpmn2:targetRef>secondLineComment</bpmn2:targetRef>
            </bpmn2:dataOutputAssociation>
        </bpmn2:userTask>

        <bpmn2:endEvent id="end" name="Processo concluido">
            <bpmn2:incoming>secondApprovalToEnd</bpmn2:incoming>
        </bpmn2:endEvent>

        <bpmn2:endEvent id="rejected" name="Reprovado na primeira alcada">
            <bpmn2:incoming>decisionToRejected</bpmn2:incoming>
        </bpmn2:endEvent>

        <bpmn2:sequenceFlow id="startToFirstApproval" sourceRef="start" targetRef="firstApproval"/>
        <bpmn2:sequenceFlow id="firstToDecision" sourceRef="firstApproval" targetRef="firstDecision"/>
        <bpmn2:sequenceFlow id="decisionToSecondApproval" sourceRef="firstDecision" targetRef="secondApproval">
            <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"
                                       language="http://www.java.com/java"><![CDATA[return Boolean.TRUE.equals(firstLineApproval);]]></bpmn2:conditionExpression>
        </bpmn2:sequenceFlow>
        <bpmn2:sequenceFlow id="decisionToRejected" sourceRef="firstDecision" targetRef="rejected"/>
        <bpmn2:sequenceFlow id="secondApprovalToEnd" sourceRef="secondApproval" targetRef="end"/>
    </bpmn2:process>

    <bpmndi:BPMNDiagram id="approvalRequestsDiagram">
        <bpmndi:BPMNPlane id="approvalRequestsPlane" bpmnElement="approvalRequests">
            <bpmndi:BPMNShape id="startShape" bpmnElement="start">
                <dc:Bounds x="120" y="210" width="56" height="56"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="firstApprovalShape" bpmnElement="firstApproval">
                <dc:Bounds x="255" y="187" width="160" height="102"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="firstDecisionShape" bpmnElement="firstDecision">
                <dc:Bounds x="475" y="210" width="56" height="56"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="secondApprovalShape" bpmnElement="secondApproval">
                <dc:Bounds x="610" y="187" width="160" height="102"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endShape" bpmnElement="end">
                <dc:Bounds x="850" y="210" width="56" height="56"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="rejectedShape" bpmnElement="rejected">
                <dc:Bounds x="610" y="345" width="56" height="56"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="startToFirstApprovalEdge" bpmnElement="startToFirstApproval">
                <di:waypoint x="176" y="238"/>
                <di:waypoint x="255" y="238"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="firstToDecisionEdge" bpmnElement="firstToDecision">
                <di:waypoint x="415" y="238"/>
                <di:waypoint x="475" y="238"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="decisionToSecondApprovalEdge" bpmnElement="decisionToSecondApproval">
                <di:waypoint x="531" y="238"/>
                <di:waypoint x="610" y="238"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="decisionToRejectedEdge" bpmnElement="decisionToRejected">
                <di:waypoint x="503" y="266"/>
                <di:waypoint x="503" y="373"/>
                <di:waypoint x="610" y="373"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="secondApprovalToEndEdge" bpmnElement="secondApprovalToEnd">
                <di:waypoint x="770" y="238"/>
                <di:waypoint x="850" y="238"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn2:definitions>
