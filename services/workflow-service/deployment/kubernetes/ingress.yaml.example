apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: workflow-service
  namespace: substitua-o-namespace
spec:
  ingressClassName: substitua-a-classe
  tls:
  - hosts:
    - workflow-service.example.com
    secretName: workflow-service-tls
  rules:
  - host: workflow-service.example.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: workflow-service
            port:
              number: 8082
