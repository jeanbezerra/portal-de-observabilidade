apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: identity-access-service
  namespace: substitua-o-namespace
spec:
  ingressClassName: substitua-a-classe
  tls:
  - hosts:
    - identity-access-service.example.com
    secretName: identity-access-service-tls
  rules:
  - host: identity-access-service.example.com
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: identity-access-service
            port:
              number: 8083
